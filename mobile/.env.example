# Copy to .env. Empty/placeholder values start the app in demo mode
# (sample spots, no live Apple/Google). Fill these in for a real backend.

# Supabase: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Express API. Simulator can use localhost. Real iPhone needs your Mac's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000
